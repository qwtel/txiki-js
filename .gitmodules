[submodule "deps/libuv"]
	path = deps/libuv
	url = git@github.com:qwtel/zig-build-libuv.git
	branch = v1.x
[submodule "deps/libffi"]
	path = deps/libffi
	url = git@github.com:libffi/libffi.git
	ignore = dirty
[submodule "deps/quickjs"]
	path = deps/quickjs
	url = git@github.com:qwtel/zig-build-quickjs.git
[submodule "deps/mimalloc"]
	path = deps/mimalloc
	url = git@github.com:qwtel/zig-build-mimalloc.git
[submodule "deps/wamr"]
	path = deps/wamr
	url = https://github.com/bytecodealliance/wasm-micro-runtime.git
